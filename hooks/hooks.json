{
  "description": "Silica vault memory: the session opens knowing which vault it is in and what code moved under its notes since the last /stale, and the transcript is captured for the drain when it ends or compacts.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from 'silica-agent[mcp]' silica hook SessionStart",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from 'silica-agent[mcp]' silica capture"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from 'silica-agent[mcp]' silica capture"
          }
        ]
      }
    ]
  }
}
