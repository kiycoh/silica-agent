  "formulas": [
    {"en": ["quadratic formula"], "it": ["formula quadratica", "formula risolutiva", "equazione di secondo grado"], "tex": "x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}"},
    {"en": ["discriminant"], "it": ["discriminante", "delta"], "tex": "\\Delta = b^2 - 4ac"},
    {"en": ["difference of squares"], "it": ["differenza di quadrati"], "tex": "a^2 - b^2 = (a + b)(a - b)"},
    {"en": ["square of a binomial", "binomial square"], "it": ["quadrato di binomio", "quadrato di un binomio"], "tex": "(a + b)^2 = a^2 + 2ab + b^2"},
    {"en": ["binomial theorem", "Newton's binomial"], "it": ["binomio di Newton", "teorema binomiale"], "tex": "(a + b)^n = \\sum_{k=0}^{n} \\binom{n}{k} a^{n-k} b^k"},
    {"en": ["geometric series"], "it": ["serie geometrica"], "tex": "\\sum_{n=0}^{\\infty} a r^n = \\frac{a}{1 - r}, \\quad |r| < 1"},
    {"en": ["Euler's formula"], "it": ["formula di Eulero"], "tex": "e^{i\\theta} = \\cos\\theta + i\\sin\\theta"},
    {"en": ["Pythagorean theorem", "Pythagoras' theorem", "Pythagoras"], "it": ["teorema di Pitagora"], "tex": "a^2 + b^2 = c^2"},
    {"en": ["area of a circle"], "it": ["area del cerchio"], "tex": "A = \\pi r^2"},
    {"en": ["circumference of a circle", "circumference"], "it": ["lunghezza della circonferenza", "circonferenza"], "tex": "C = 2\\pi r"},
    {"en": ["area of a triangle"], "it": ["area del triangolo"], "tex": "A = \\frac{1}{2} b h"},
    {"en": ["volume of a sphere"], "it": ["volume della sfera"], "tex": "V = \\frac{4}{3}\\pi r^3"},
    {"en": ["surface area of a sphere"], "it": ["superficie della sfera", "area della superficie sferica"], "tex": "A = 4\\pi r^2"},
    {"en": ["distance between two points", "distance formula"], "it": ["distanza tra due punti"], "tex": "d = \\sqrt{(x_2 - x_1)^2 + (y_2 - y_1)^2}"},
    {"en": ["Pythagorean trigonometric identity", "fundamental trigonometric identity"], "it": ["relazione fondamentale della goniometria", "identità fondamentale della trigonometria"], "tex": "\\sin^2\\theta + \\cos^2\\theta = 1"},
    {"en": ["law of sines", "sine rule"], "it": ["teorema dei seni"], "tex": "\\frac{a}{\\sin\\alpha} = \\frac{b}{\\sin\\beta} = \\frac{c}{\\sin\\gamma}"},
    {"en": ["law of cosines", "cosine rule"], "it": ["teorema del coseno", "teorema di Carnot"], "tex": "c^2 = a^2 + b^2 - 2ab\\cos\\gamma"},
    {"en": ["sine addition formula"], "it": ["formula di addizione del seno"], "tex": "\\sin(\\alpha + \\beta) = \\sin\\alpha\\cos\\beta + \\cos\\alpha\\sin\\beta"},
    {"en": ["definition of the derivative", "difference quotient"], "it": ["definizione di derivata", "limite del rapporto incrementale"], "tex": "f'(x) = \\lim_{h \\to 0} \\frac{f(x + h) - f(x)}{h}"},
    {"en": ["power rule"], "it": ["derivata di una potenza"], "tex": "\\frac{d}{dx} x^n = n x^{n-1}"},
