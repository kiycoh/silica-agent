# ============================================================================
# Silica — configuration
# Copy this file to ~/.silica/.env — the one .env Silica reads (`silica init`
# does it for you). Every line is commented out; defaults apply when unset.
# Ordered from essential to expert: stop reading when you have enough.
# ============================================================================


# ----------------------------------------------------------------------------
# 1. REQUIRED (the first-run wizard fills these for you)
# ----------------------------------------------------------------------------

# Main LLM model (litellm format).
# Examples: openrouter/anthropic/claude-sonnet-4-20250514, openai/gpt-4o,
#           ollama/qwen3.5:9b, lmstudio/qwen/qwen3.5-9b
# Local default (what `silica init` proposes): Qwen3.5-9B at Q4_K_M, sized to
# share a 12 GB GPU with the embedder and the reranker below. On llama-server:
#   SILICA_MODEL=custom/qwen3.5-9b  +  SILICA_PROVIDER_BASE_URL=http://127.0.0.1:1237/v1
#   llama-server -m Qwen3.5-9B-Q4_K_M.gguf -c 65536 --port 1237
# SILICA_MODEL=openrouter/deepseek/deepseek-v4-flash

# Provider preset (derived from SILICA_MODEL when unset).
# One of: openrouter, lmstudio, ollama, gemini, openai, groq, deepseek,
# mistral, xai, custom. Silica is tool-driven — with ollama pick a model that
# supports function-calling (llama3.1, qwen2.5); text-only models will stall.
# SILICA_PROVIDER=openrouter

# Ollama only: silica follows ollama's own OLLAMA_HOST (host, host:port, or a
# full URL; port defaults to 11434), so a remote or non-default server needs no
# silica-side setting.
# OLLAMA_HOST=localhost:11434

# Ollama only: context window silica pins on every request, capped at the model's
# trained maximum. Ollama's own 4096 default drops everything past the window
# with no error, and the toolset alone is ~8k tokens, so at that default the
# model never sees the tools. Raise for long turns, lower to save VRAM (the KV
# cache scales with it). `silica doctor` warns when it cannot hold a turn.
# OLLAMA_NUM_CTX=16384

# API key for the provider above. ANTHROPIC_API_KEY / OPENAI_API_KEY are only
# needed when SILICA_MODEL targets that provider directly (litellm reads them).
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# More keys for one provider: numbered siblings of its key variable, read up
# to the first gap. A key the endpoint rate-limits sits out a minute, one it
# refuses or bills out an hour, and the next key serves meanwhile (ADR-0063).
# OPENROUTER_API_KEY_2=
# OPENROUTER_API_KEY_3=

# Models tried in order when a call's own model fails at its endpoint: down,
# overloaded, rate-limited past its retries, a refused key, a model it does
# not have. Never on a 400, which would fail anywhere. A model that failed
# waits behind the others for five minutes.
# SILICA_FALLBACK_MODELS=openrouter/deepseek/deepseek-v4-flash,lmstudio/qwen3.5-9b

# There is no vault setting here: `silica` curates the folder you launch it in
# (the repo root, when that folder is inside one), and ~/.silica/vault when
# that folder is $HOME. A SILICA_VAULT line in this file is ignored; export
# it in the shell (`SILICA_VAULT=/path silica`, a cron unit) to pin one.


# ----------------------------------------------------------------------------
# 2. CUSTOM ENDPOINT — only with SILICA_PROVIDER=custom
# ----------------------------------------------------------------------------
# Any OpenAI-compatible server without a dedicated preset: vLLM, llama.cpp,
# LocalAI, Jan, or a hosted vendor. Both variables route the "custom" preset.

# SILICA_PROVIDER_BASE_URL=http://localhost:8080/v1
# SILICA_PROVIDER_API_KEY=


# ----------------------------------------------------------------------------
# 3. RACCOMANDED OPTIONS — embeddings, vault behavior, UI
# ----------------------------------------------------------------------------

# Embedding model for semantic search and deduplication. Default: EmbeddingGemma 2
# (Q8_0, ggml-org/embeddinggemma-2-GGUF); the id is the store's identity, so changing
# it re-embeds every note. The id also picks the role prompts and the cosine
# thresholds (EMBEDDER_DEFAULTS in silica/config.py): an id it does not know keeps
# the Qwen3-Embedding ones. Example: text-embedding-qwen3-embedding-0.6b (LM Studio,
# the previous default), text-embedding-3-small (OpenAI)
# SILICA_EMBEDDING_MODEL=embeddinggemma-2
# Role prompts for asymmetric embedders (jina-embeddings-v5 retrieval: "Query: " /
# "Document: "). The embedder's own pair when it has one, else empty; quote a
# value that ends in a space.
# SILICA_EMBEDDING_QUERY_PREFIX="Query: "
# SILICA_EMBEDDING_DOCUMENT_PREFIX="Document: "

# Embeddings endpoint and its API key. The default is a local llama-server or LM
# Studio, whichever answers at this URL. EmbeddingGemma 2 needs a llama.cpp built
# on or after 2026-10-06; older builds refuse the gemma-embedding2 architecture.
#   llama-server -m embeddinggemma-2-Q8_0.gguf --embedding -b 2048 -ub 2048 --cache-ram 0 --port 1234
# SILICA_EMBEDDING_BASE_URL=http://localhost:1234/v1
# SILICA_EMBEDDING_API_KEY=lm-studio

# AUTOSTART — the command that serves a local endpoint. When the port is closed
# Silica runs this through the shell and waits for it, instead of degrading to
# co-occurrence because the server was not up. Unset = start it yourself.
# Logs land in ~/.silica/logs/<endpoint>-server.log.
# SILICA_EMBEDDING_SERVE_CMD=lms server start
# SILICA_PROVIDER_SERVE_CMD=ollama serve

# Git commit safety net for vault writes: off (default) or auto
# SILICA_GIT_COMMIT=off

# Remember your own silica sessions (True/False, default False). On, each
# conversation is deposited in ~/.silica/inbox/ when it ends, and /nucleate
# distills it into episodic facts — never into notes: what you keep, you keep by
# promoting it. /incognito turns it off for the session you are in.
# SILICA_CAPTURE_SESSIONS=False

# Memory: what you ask silica to remember about you and this vault, shown to
# every chat (True/False, default True; ADR-0076). Two files under
# ~/.silica/memory/, editable in Settings > Memory or with /remember and
# /memory. False pauses it: nothing shown, nothing saved, the files are kept.
# SILICA_MEMORY=True

# Inbox folder inside the vault, for staging inbound files. Default: Inbox
# SILICA_INBOX_DIR=Inbox

# Tool progress display level: off, new, all, verbose
# SILICA_TOOL_PROGRESS=all

# Show reasoning/thinking blocks from the model (True/False)
# SILICA_SHOW_THINKING=True

# Startup banner art (True → wordmark, False → plain one-liner)
# SILICA_SHOW_BANNER=True

# Debug logging on stderr (True/False)
# SILICA_VERBOSE=False


# ----------------------------------------------------------------------------
# 4. ADVANCED — workers, context, search, PDF
# ----------------------------------------------------------------------------

# Sub-agent worker model for background tasks (dedup, refiner). If unset,
# workers fall back to the main model configuration.
# SILICA_WORKER_MODEL=openrouter/mistralai/mistral-small-2603
# SILICA_WORKER_PROVIDER=openrouter
# SILICA_WORKER_API_KEY=lm-studio

# Typed-decision model in front of the form sniff (TypeSafe Jev through
# OpenRouter's Decisions endpoint, billed to OPENROUTER_API_KEY). Off when
# unset: the sniff runs its LLM call. A confident verdict replaces that call;
# uncertainty and any error fall through to it. Pin a dated id, not jev-latest.
# SILICA_DECISION_MODEL=typesafe/jev-1.13

# Concurrency caps: sub-agent threads (default 3), worker LLM calls (default 4)
# SILICA_SUBAGENT_MAX_CONCURRENT=3
# SILICA_WORKER_MAX_CONCURRENT=4

# Context window pin for LOCAL providers (LM Studio, Ollama) only; OpenRouter
# always uses the provider-reported context_length. Auto-detected if unset.
# SILICA_MAX_CONTEXT=60000

# Max generation tokens fallback. Default: 32768. Oversized values shrink the
# OpenRouter provider pool (endpoints with a smaller output cap are dropped).
# MAX_TOKENS=32768

# Tavily API key (enables /web-search). Bare TAVILY_API_KEY works as fallback.
# SILICA_TAVILY_API_KEY=

# PDF-to-Markdown converter: pdfium (default, base install, no OCR), mineru
# (the only one with OCR — `pip install 'mineru[pipeline]'`), docling, or
# opendataloader. The last three install separately; `silica doctor` says
# whether mineru is on PATH. OCR languages are used by docling only.
# SILICA_PDF_PROVIDER=mineru
# SILICA_PDF_OCR_LANG=en,it,fr,de,es

# Driver backend: fs (default, headless filesystem). The Obsidian plugin
# bridge installs the ws backend live at dial-in; never set ws here.
# SILICA_BACKEND=fs

# Vault display name (prompt fallback when no vault path is set)
# SILICA_VAULT_NAME=My Vault


# ----------------------------------------------------------------------------
# 5. RERANKER — recall reordering
# ----------------------------------------------------------------------------
# A cross-encoder reads query and candidate TOGETHER and reorders recall
# results. It is not an LLM and not an embedding model, so LM Studio and
# Ollama cannot serve one. Silica serves its own from the [rerank] extra:
#
#     pip install silica-agent[rerank]
#
# (~2GB weights on first use), one server every silica process shares. The
# wizard writes these three lines; written by hand, use the interpreter the
# extra is installed in:
# SILICA_RERANK_BASE_URL=http://127.0.0.1:1235/v1
# SILICA_RERANK_MODEL=mixedbread-ai/mxbai-rerank-base-v2
# SILICA_RERANK_SERVE_CMD="/path/to/python" -m silica.agent.rerank_serve
# Any /rerank-protocol server works on the URL instead
# (llama.cpp/Infinity/Jina/Cohere). Local example:
#   llama-server -m bge-reranker-v2-m3.gguf --reranking --port 1235
# SILICA_RERANK_MODEL=bge-reranker-v2-m3-Q8_0
# SILICA_RERANK_API_KEY=lm-studio
# Down, loading or unset, reranking is skipped and the pool's order stands.
# Seconds one call may take; a CPU-only server needs well above the default 5:
# SILICA_RERANK_TIMEOUT=5
# Weights the [rerank] server loads: a HuggingFace repo id or a local
# directory. Empty = mixedbread-ai/mxbai-rerank-base-v2. jinaai/jina-reranker-v3*
# runs too (listwise, loaded with its own remote code), but is CC-BY-NC.
# SILICA_LOCAL_RERANK_MODEL=


# ----------------------------------------------------------------------------
# 6. SPEECH: dictation in the web GUI, reading Learn aloud
# ----------------------------------------------------------------------------
# The microphone tries three transcribers in order. First a served one: any
# OpenAI-compatible /audio/transcriptions endpoint (whisper.cpp's whisper-server,
# faster-whisper-server, OpenAI). /convert's audio and video lane uses it too.
# SILICA_STT_BASE_URL=http://localhost:1236/v1
# SILICA_STT_MODEL=whisper-1
# SILICA_STT_LANG=auto
# SILICA_STT_SERVE_CMD=whisper-server -m ggml-small.bin --port 1236
# Then in process, when that endpoint does not answer:
#
#     pip install 'silica-agent[stt]'
#
# (~480 MB of weights on first use, CPU). A faster-whisper size, a HuggingFace
# repo id or a local directory; empty = small.
# SILICA_STT_LOCAL_MODEL=
# Last, the browser's own recognizer: off, on-device (audio stays in the
# browser) or cloud (Chrome sends it to Google). The same setting decides
# whether Learn may read aloud with a network voice.
# SILICA_STT_BROWSER=off


# ----------------------------------------------------------------------------
# 7. EXPERT — similarity thresholds, mindmap, token budgets
# ----------------------------------------------------------------------------
# All have safe defaults; override only to tune behavior/cost.

# Dedup: ≥ HIGH → patch existing note; ≤ LOW → new note. Title threshold
# promotes a pair into the borderline window; THEME is the keep floor.
# SILICA_SIM_THRESHOLD_HIGH=0.85
# SILICA_SIM_THRESHOLD_LOW=0.75
# SILICA_SIM_TITLE_THRESHOLD=0.80
# SILICA_SIM_THRESHOLD_THEME=0.35

# Candidate notes retrieved per note during dedup scans. Default: 5
# SILICA_DEDUP_SCAN_K=5

# Language for the co-occurrence graph. Default: auto
# SILICA_COOCCURRENCE_LANG=auto

# Invocation-time index sweep: before a query reads the indexes, detect notes
# created, edited, or deleted out-of-band (Obsidian, rm, git) and refresh the
# seeded indexes. Off = you own freshness via /embed, /cooccur, /lexical.
# Default: true
# SILICA_INDEX_SWEEP=true

# Replay distiller replies from ~/.silica/cache/distill instead of asking the
# model again. Keyed by the prompt text (the directory) and the call inputs
# (the entry), so editing a prompt cannot serve a reply the old one produced.
# For frozen benchmark arms: a hit replays verbatim, which is wrong for a live
# vault whose sources change under an unchanged prompt.
# Default: 0 (off)
# SILICA_DISTILL_CACHE=1

# Mindmap (/map <note>): node cap, latent neighbours, wikilink BFS depth
# SILICA_MINDMAP_MAX_NODES=35
# SILICA_MINDMAP_LATENT_K=10
# SILICA_MINDMAP_HOPS=2

# NOTE: read WITHOUT the SILICA_ prefix (bare names).
# MODEL_CONTEXT_WINDOW=0             # 0 = auto-detect from the model
# DISTILLER_MAX_TOKENS=0             # 0 = derive from context window
# DISTILLER_TOKEN_SAFETY_MARGIN=2048
# DISTILLER_CHUNK_MAX_BYTES=30720    # 30 * 1024
