          "Specificità e Sensibilità"
        ],
        "concepts": [
          "tasso di falsi positivi",
          "FPR",
          "curva ROC",
          "sensibilità",
          "specificità",
          "AUC",
          "statistica di Wilcoxon"
        ],
        "reason": null,
